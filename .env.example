# ---------------------------------------------------------------------------
# Naijaproperty — environment template
# Copy to .env and fill. NEVER commit the filled .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Public URLs ------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Naijaproperty

# --- Database ---------------------------------------------------------------
# Local Docker: host.docker.internal is not needed since the API runs on the host.
DATABASE_URL=postgresql://naijaproperty:naijaproperty@localhost:5432/naijaproperty?schema=public
SHADOW_DATABASE_URL=postgresql://naijaproperty:naijaproperty@localhost:5432/naijaproperty_shadow?schema=public
DATABASE_POOL_MAX=20

# --- Redis (sessions cache, rate limits, OTP fallback queue) ----------------
REDIS_URL=redis://localhost:6379

# --- Auth: secrets ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# HMAC pepper for OTP code hashing
OTP_PEPPER=
# 32-byte key (hex or base64) for envelope-encrypting PII at rest
PII_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Google OAuth -----------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email sender -----------------------------------------------------------
# Any SMTP provider (Postmark / Resend / SES / SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Naijaproperty <no-reply@naijaproperty.ng>

# --- Termii (WhatsApp-first OTP, SMS fallback) ------------------------------
# Base URL is account+region specific. Dashboard -> Settings -> API token.
TERMII_API_KEY=
TERMII_BASE_URL=
# Sender device name for WhatsApp; alphanumeric ID for SMS (3-11 chars)
TERMII_WHATSAPP_FROM=
TERMII_SMS_FROM=Naijaproperty
# Webhook signing secret for X-Termii-Signature (HMAC SHA512)
TERMII_WEBHOOK_SECRET=
# Seconds to wait for a WhatsApp DELIVERED webhook before falling back to SMS
OTP_SMS_FALLBACK_DELAY_SECONDS=20
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Media: Cloudflare R2 ---------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=naijaproperty-media
R2_PUBLIC_URL=
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- Media: Cloudflare Stream (walkthrough video) ---------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# --- Observability / infra --------------------------------------------------
LOG_LEVEL=debug
TURNSTILE_SECRET_KEY=

# --- Bootstrap admin (seed only) --------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
